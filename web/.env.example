# 這個檔案會進版控，只列變數名稱，不要在這裡填值。
# 複製成 web/.env.local 後，在 .env.local 填入。.env.local 不會進版控，不要把金鑰貼到任何地方。

# ---- Supabase（Project Settings → API）----
# 專案網址，例如 https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# publishable key（sb_publishable_ 開頭）：可以出現在瀏覽器，權限受 RLS 限制
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key（sb_secret_ 開頭）：可以繞過 RLS，只能放在伺服器端，絕對不可以加 NEXT_PUBLIC_ 前綴
SUPABASE_SECRET_KEY=

# ---- 網站網址（登入後導回用）；本機開發是 http://localhost:3000 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 模型 ----
# anthropic（真實呼叫，會花錢）或 mock（假資料，不花錢）；自動化測試一律 mock
LLM_PROVIDER=mock
# Anthropic API 金鑰，只放伺服器端；LLM_PROVIDER=mock 時不需要
ANTHROPIC_API_KEY=

# ---- Inngest 背景工作 ----
# 本機開發不需要填：另開一個終端機執行 npx inngest-cli@latest dev 即可。
# 部署到正式環境時才需要（Inngest 後台 → Manage → Event Keys / Signing Key）。
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
